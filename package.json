{
	"name": "music-app",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "WRANGLER_REGISTRY_PATH=.wrangler/registry/music WRANGLER_CACHE_DIR=.wrangler/cache WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/logs vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/crypto-js": "^4.2.2",
		"@types/md5": "^2.3.6",
		"@types/node": "^26.0.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.0.16",
		"wrangler": "^4.107.0"
	},
	"dependencies": {
		"@pixi/filter-adjustment": "^5.1.1",
		"@pixi/filter-twist": "^5.1.1",
		"@sentry/sveltekit": "^10.64.0",
		"crypto-js": "^4.2.0",
		"md5": "^2.3.0",
		"pixi.js": "^7.4.3"
	}
}
